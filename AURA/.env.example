# AURA Platform Environment Configuration
# Copy to .env and fill in your values

# ── Required ──
LLM_PROVIDER=qgenie
LLM_MOCK_MODE=false
OPENAI_API_KEY=sk-your-key-here
# QGENIE_API_KEY=<optional-if-QGENIE_CLI_HOME-has-config>
# QGENIE_CLI_HOME=/path/to/qgenie-cli
# QGENIE_COMMAND=qgenie
# QGENIE_BINARY_HOST_PATH=/usr2/nandam/.local/bin/qgenie
# QGENIE_CLI_HOME_HOST_PATH=~/.config/qgenie-cli
JWT_SECRET=change-me-to-a-random-string-min-32-chars

# ── Optional (defaults shown) ──
LOG_LEVEL=INFO
TOKEN_BUDGET_DAILY=1000000
CACHE_SIZE=10000
MAX_CONCURRENT_AGENTS=50
AGENT_TIMEOUT_SECONDS=300
ADMIN_EMAIL=admin@aura.local
ADMIN_PASSWORD=admin123
# Runtime UID/GID for non-root core container process.
# Set to your host user/group IDs (run: `id -u` and `id -g`).
AURA_RUN_UID=1000
AURA_RUN_GID=1000

# ── Kernel Sources (read-only mount) ──
# KERNEL_SOURCES_PATH=/path/to/linux-stable

# ── Simulation ──
QEMU_ENABLED=false
