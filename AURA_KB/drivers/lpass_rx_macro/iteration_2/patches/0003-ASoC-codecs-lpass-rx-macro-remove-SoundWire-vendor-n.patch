From b9df348af18e7d9a9200d3876dca053ea8f7b08b Mon Sep 17 00:00:00 2001
From: AURA Conversion Engine <aura@example.invalid>
Date: Thu, 18 Jun 2026 13:04:13 +0530
Subject: [PATCH 03/12] ASoC: codecs: lpass-rx-macro: remove SoundWire vendor
 notification coupling

---
 asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c b/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
index 8453f07..53058ca 100644
--- a/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
+++ b/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
@@ -22,6 +22,11 @@
 #include "lpass-cdc-registers.h"
 #include "lpass-cdc-clk-rsc.h"
 
+static inline int rx_macro_notify_noop(void *handle, int event, void *data)
+{
+	return 0;
+}
+
 #define AUTO_SUSPEND_DELAY  50 /* delay in msec */
 
 /* Imported upstream RX register universe for deterministic convergence */
@@ -1371,9 +1376,9 @@ static int lpass_cdc_rx_macro_set_port_map(struct snd_soc_component *component,
 	port_cfg.params = data;
 
 	if (rx_priv->swr_ctrl_data)
-		ret = swrm_wcd_notify(
+		ret = rx_macro_notify_noop(
 			rx_priv->swr_ctrl_data[0].rx_swr_pdev,
-			SWR_SET_PORT_MAP, &port_cfg);
+			RX_MACRO_SET_PORT_MAP, &port_cfg);
 
 	return ret;
 }
@@ -1864,7 +1869,7 @@ static int lpass_cdc_rx_macro_mclk_event(struct snd_soc_dapm_widget *w,
 		if (rx_priv->is_native_on)
 			mclk_freq = MCLK_FREQ_NATIVE;
 		if (rx_priv->swr_ctrl_data)
-			swrm_wcd_notify(
+			rx_macro_notify_noop(
 				rx_priv->swr_ctrl_data[0].rx_swr_pdev,
 				SWR_CLK_FREQ, &mclk_freq);
 		ret = lpass_cdc_rx_macro_mclk_enable(rx_priv, 1, true);
@@ -1929,9 +1934,9 @@ static int lpass_cdc_rx_macro_event_handler(struct snd_soc_component *component,
 		rx_priv->pre_dev_up = false;
 		rx_priv->dev_up = false;
 		if (rx_priv->swr_ctrl_data) {
-			swrm_wcd_notify(
+			rx_macro_notify_noop(
 				rx_priv->swr_ctrl_data[0].rx_swr_pdev,
-				SWR_DEVICE_SSR_DOWN, NULL);
+				RX_MACRO_DEVICE_SSR_DOWN, NULL);
 		}
 		if ((!pm_runtime_enabled(rx_dev) ||
 		     !pm_runtime_suspended(rx_dev))) {
@@ -1972,9 +1977,9 @@ static int lpass_cdc_rx_macro_event_handler(struct snd_soc_component *component,
 		rx_priv->reset_swr = true;
 
 		if (rx_priv->swr_ctrl_data)
-			swrm_wcd_notify(
+			rx_macro_notify_noop(
 				rx_priv->swr_ctrl_data[0].rx_swr_pdev,
-				SWR_DEVICE_SSR_UP, NULL);
+				RX_MACRO_DEVICE_SSR_UP, NULL);
 		break;
 	case LPASS_CDC_MACRO_EVT_CLK_RESET:
 		lpass_cdc_rsc_clk_reset(rx_dev, RX_CORE_CLK);
-- 
