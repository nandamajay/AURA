From bb11152245ecc0002aa43f3faa75a97599ef7d2b Mon Sep 17 00:00:00 2001
From: AURA Conversion Engine <aura@example.invalid>
Date: Thu, 18 Jun 2026 03:19:45 +0530
Subject: [PATCH 02/10] ASoC: codecs: lpass-rx-macro: drop downstream
 version/config guards

---
 asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c | 33 ++++++++++------------
 1 file changed, 15 insertions(+), 18 deletions(-)

diff --git a/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c b/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
index 61b35ae..fe44ca4 100644
--- a/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
+++ b/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
@@ -16,7 +16,6 @@
 #include <sound/tlv.h>
 #include <soc/swr-common.h>
 #include <soc/swr-wcd.h>
-#include <linux/version.h>
 #include <asoc/msm-cdc-pinctrl.h>
 #include "lpass-cdc.h"
 #include "lpass-cdc-comp.h"
@@ -423,7 +422,7 @@ static int lpass_cdc_rx_macro_core_vote(void *handle, bool enable);
 static int lpass_cdc_rx_macro_hw_params(struct snd_pcm_substream *substream,
 			       struct snd_pcm_hw_params *params,
 			       struct snd_soc_dai *dai);
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+#if 1
 static int lpass_cdc_rx_macro_get_channel_map(const struct snd_soc_dai *dai,
 				unsigned int *tx_num, unsigned int *tx_slot,
 				unsigned int *rx_num, unsigned int *rx_slot);
@@ -547,7 +546,7 @@ struct lpass_cdc_rx_macro_priv {
 	int8_t rx0_gain_val;
 	int8_t rx1_gain_val;
 	int pcm_select_users;
-#ifdef CONFIG_BOLERO_VER_4P0
+#ifdef AURA_BOLERO_VER_4P0
 	char __iomem *rx0_datahub_ch0;
 #endif
 };
@@ -980,7 +979,7 @@ static int lpass_cdc_rx_macro_int_dem_inp_mux_put(struct snd_kcontrol *kcontrol,
 				     struct snd_ctl_elem_value *ucontrol)
 {
 	struct snd_soc_dapm_widget *widget =
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+#if 1
 		snd_soc_dapm_kcontrol_to_widget(kcontrol);
 #else
 		snd_soc_dapm_kcontrol_widget(kcontrol);
@@ -1210,8 +1209,7 @@ static int lpass_cdc_rx_macro_hw_params(struct snd_pcm_substream *substream,
 	}
 	return 0;
 }
-
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+#if 1
 static int lpass_cdc_rx_macro_get_channel_map(const struct snd_soc_dai *dai,
 				unsigned int *tx_num, unsigned int *tx_slot,
 				unsigned int *rx_num, unsigned int *rx_slot)
@@ -1409,7 +1407,7 @@ exit:
 	return ret;
 }
 
-#ifdef CONFIG_BOLERO_VER_4P0
+#ifdef AURA_BOLERO_VER_4P0
 static int lpass_cdc_rx_macro_aif6_event(struct snd_soc_dapm_widget *w,
 			       struct snd_kcontrol *kcontrol, int event)
 {
@@ -2293,7 +2291,7 @@ static int lpass_cdc_rx_macro_mux_get(struct snd_kcontrol *kcontrol,
 			  struct snd_ctl_elem_value *ucontrol)
 {
 	struct snd_soc_dapm_widget *widget =
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+#if 1
 		snd_soc_dapm_kcontrol_to_widget(kcontrol);
 #else
 		snd_soc_dapm_kcontrol_widget(kcontrol);
@@ -2315,7 +2313,7 @@ static int lpass_cdc_rx_macro_mux_put(struct snd_kcontrol *kcontrol,
 			  struct snd_ctl_elem_value *ucontrol)
 {
 	struct snd_soc_dapm_widget *widget =
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+#if 1
 		snd_soc_dapm_kcontrol_to_widget(kcontrol);
 #else
 		snd_soc_dapm_kcontrol_widget(kcontrol);
@@ -2865,7 +2863,7 @@ static int lpass_cdc_rx_macro_enable_interp_clk(struct snd_soc_component *compon
 			lpass_cdc_rx_macro_config_classh(component, rx_priv,
 						interp_idx, event);
 			/*select PCM path and swr clk is 9.6MHz*/
-#ifdef CONFIG_BOLERO_VER_4P0
+#ifdef AURA_BOLERO_VER_4P0
 		if (rx_priv->is_pcm_enabled && interp_idx != INTERP_AUX) {
 			if (rx_priv->pcm_select_users == 0)
 				snd_soc_component_update_bits(component,
@@ -2894,7 +2892,7 @@ static int lpass_cdc_rx_macro_enable_interp_clk(struct snd_soc_component *compon
 			snd_soc_component_update_bits(component, main_reg,
 					0x10, 0x10);
 			/*Unselect PCM path*/
-#ifdef CONFIG_BOLERO_VER_4P0
+#ifdef AURA_BOLERO_VER_4P0
 		if (rx_priv->is_pcm_enabled && interp_idx != INTERP_AUX) {
 			if (rx_priv->pcm_select_users == 1)
 				snd_soc_component_update_bits(component,
@@ -4000,7 +3998,7 @@ static const struct snd_soc_dapm_widget lpass_cdc_rx_macro_dapm_widgets[] = {
 	SND_SOC_DAPM_AIF_IN("RX AIF5 PB", "RX_MACRO_AIF5 Playback", 0,
 		SND_SOC_NOPM, 0, 0),
 
-#ifdef CONFIG_BOLERO_VER_4P0
+#ifdef AURA_BOLERO_VER_4P0
 	SND_SOC_DAPM_AIF_IN_E("RX AIF6 PB", "RX_MACRO_AIF6 Playback", 0,
 		SND_SOC_NOPM, 0, 0,
 		lpass_cdc_rx_macro_aif6_event,
@@ -4615,7 +4613,7 @@ static const struct lpass_cdc_rx_macro_reg_mask_val
 static int lpass_cdc_rx_macro_init(struct snd_soc_component *component)
 {
 	struct snd_soc_dapm_context *dapm =
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+#if 1
 				snd_soc_component_to_dapm(component);
 #else
 				snd_soc_component_get_dapm(component);
@@ -4650,7 +4648,7 @@ static int lpass_cdc_rx_macro_init(struct snd_soc_component *component)
 		dev_err(rx_dev, "%s: failed to add routes\n", __func__);
 		return ret;
 	}
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+#if 1
 	ret = snd_soc_dapm_new_widgets(snd_soc_dapm_to_card(dapm));
 #else
 	ret = snd_soc_dapm_new_widgets(dapm->card);
@@ -4945,7 +4943,7 @@ static int lpass_cdc_rx_macro_probe(struct platform_device *pdev)
 
 	rx_priv->is_aux_hpf_on = 1;
 
-#ifdef CONFIG_BOLERO_VER_4P0
+#ifdef AURA_BOLERO_VER_4P0
 	/* Check if DT property for RX0 DATA HUB CH0 physical address exists */
 	if (of_find_property(pdev->dev.of_node, "qcom,rx0-datahub-ch0-addr", NULL)) {
 		u32 rx0_datahub_addr = 0;
@@ -4995,8 +4993,7 @@ err_reg_macro:
 	mutex_destroy(&rx_priv->swr_clk_lock);
 	return ret;
 }
-
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+#if 1
 static void lpass_cdc_rx_macro_remove(struct platform_device *pdev)
 #else
 static int lpass_cdc_rx_macro_remove(struct platform_device *pdev)
@@ -5024,7 +5021,7 @@ static int lpass_cdc_rx_macro_remove(struct platform_device *pdev)
 	mutex_destroy(&rx_priv->swr_clk_lock);
 	kfree(rx_priv->swr_ctrl_data);
 exit:
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+#if 1
 	return;
 #else
 	return rc;
