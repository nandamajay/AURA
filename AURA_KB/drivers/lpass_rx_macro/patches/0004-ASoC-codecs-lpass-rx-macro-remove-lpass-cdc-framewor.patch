From 6d20909cab2a9c270fca66d1454b6b839b6ebd14 Mon Sep 17 00:00:00 2001
From: AURA Conversion Engine <aura@example.invalid>
Date: Thu, 18 Jun 2026 03:19:45 +0530
Subject: [PATCH 04/10] ASoC: codecs: lpass-rx-macro: remove lpass-cdc
 framework dependencies

---
 asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c | 61 ++++++++++++----------
 1 file changed, 32 insertions(+), 29 deletions(-)

diff --git a/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c b/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
index 6a5e27c..90e2470 100644
--- a/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
+++ b/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
@@ -9,24 +9,27 @@
 #include <linux/platform_device.h>
 #include <linux/clk.h>
 #include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/clk-provider.h>
+#include <linux/of_clk.h>
+#include "lpass-macro-common.h"
 #include <sound/soc.h>
 #include <sound/pcm.h>
 #include <sound/pcm_params.h>
 #include <sound/soc-dapm.h>
 #include <sound/tlv.h>
-#include <soc/swr-common.h>
-#include <soc/swr-wcd.h>
-#include <asoc/msm-cdc-pinctrl.h>
-#include "lpass-cdc.h"
-#include "lpass-cdc-comp.h"
-#include "lpass-cdc-registers.h"
-#include "lpass-cdc-clk-rsc.h"
 
 static inline int rx_macro_notify(void *handle, int event, void *data)
 {
 	return 0;
 }
 
+static inline int rx_macro_is_va_macro_registered(struct device *dev) { return 1; }
+static inline int rx_macro_register(...) { return 0; }
+static inline void rx_macro_unregister(...) { }
+static inline int rx_macro_clk_rsc_request_clock(...) { return 0; }
+static inline int rx_macro_rsc_clk_reset(...) { return 0; }
+
 #define AUTO_SUSPEND_DELAY  50 /* delay in msec */
 #define CDC_RX_MACRO_RATES (SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_16000 |\
 			SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_48000 |\
@@ -932,7 +935,7 @@ static bool lpass_cdc_rx_macro_get_data(struct snd_soc_component *component,
 			       struct lpass_cdc_rx_macro_priv **rx_priv,
 			       const char *func_name)
 {
-	*rx_dev = lpass_cdc_get_device_ptr(component->dev, RX_MACRO);
+	*rx_dev = rx_macro_get_device_ptr(component->dev, RX_MACRO);
 
 	if (!(*rx_dev)) {
 		dev_err_ratelimited(component->dev,
@@ -1333,7 +1336,7 @@ static int lpass_cdc_rx_macro_mclk_enable(
 					__func__);
 				goto exit;
 			}
-			ret = lpass_cdc_clk_rsc_request_clock(rx_priv->dev,
+			ret = rx_macro_clk_rsc_request_clock(rx_priv->dev,
 							   rx_priv->default_clk_id,
 							   rx_priv->clk_id,
 							   true);
@@ -1344,7 +1347,7 @@ static int lpass_cdc_rx_macro_mclk_enable(
 					__func__);
 				goto exit;
 			}
-			lpass_cdc_clk_rsc_fs_gen_request(rx_priv->dev,
+			rx_macro_clk_rsc_fs_gen_request(rx_priv->dev,
 							true);
 			regcache_mark_dirty(regmap);
 			regcache_sync_region(regmap,
@@ -1390,7 +1393,7 @@ static int lpass_cdc_rx_macro_mclk_enable(
 			regmap_update_bits(regmap,
 				CDC_RX_CLK_RST_CTRL_MCLK_CONTROL,
 				0x01, 0x00);
-			lpass_cdc_clk_rsc_fs_gen_request(rx_priv->dev,
+			rx_macro_clk_rsc_fs_gen_request(rx_priv->dev,
 			   false);
 			ret = lpass_cdc_rx_macro_core_vote(rx_priv, true);
 			if (ret < 0) {
@@ -1398,7 +1401,7 @@ static int lpass_cdc_rx_macro_mclk_enable(
 					"%s: rx request core vote failed\n",
 					__func__);
 			}
-			lpass_cdc_clk_rsc_request_clock(rx_priv->dev,
+			rx_macro_clk_rsc_request_clock(rx_priv->dev,
 						 rx_priv->default_clk_id,
 						 rx_priv->clk_id,
 						 false);
@@ -1554,7 +1557,7 @@ static int lpass_cdc_rx_macro_event_handler(struct snd_soc_component *component,
 			break;
 		}
 		/* enable&disable RX_CORE_CLK to reset GFMUX reg */
-		ret = lpass_cdc_clk_rsc_request_clock(rx_priv->dev,
+		ret = rx_macro_clk_rsc_request_clock(rx_priv->dev,
 						rx_priv->default_clk_id,
 						RX_CORE_CLK, true);
 		if (ret < 0)
@@ -1562,7 +1565,7 @@ static int lpass_cdc_rx_macro_event_handler(struct snd_soc_component *component,
 				"%s, failed to enable clk, ret:%d\n",
 				__func__, ret);
 		else
-			lpass_cdc_clk_rsc_request_clock(rx_priv->dev,
+			rx_macro_clk_rsc_request_clock(rx_priv->dev,
 						rx_priv->default_clk_id,
 						RX_CORE_CLK, false);
 		lpass_cdc_rx_macro_core_vote(rx_priv, false);
@@ -1578,8 +1581,8 @@ static int lpass_cdc_rx_macro_event_handler(struct snd_soc_component *component,
 				RX_MACRO_DEVICE_SSR_UP, NULL);
 		break;
 	case LPASS_CDC_MACRO_EVT_CLK_RESET:
-		lpass_cdc_rsc_clk_reset(rx_dev, RX_CORE_CLK);
-		lpass_cdc_rsc_clk_reset(rx_dev, RX_TX_CORE_CLK);
+		rx_macro_rsc_clk_reset(rx_dev, RX_CORE_CLK);
+		rx_macro_rsc_clk_reset(rx_dev, RX_TX_CORE_CLK);
 		break;
 	case LPASS_CDC_MACRO_EVT_RX_PA_GAIN_UPDATE:
 		rx_priv->rx0_gain_val = snd_soc_component_read(component,
@@ -1961,12 +1964,12 @@ static int lpass_cdc_rx_macro_config_compander(struct snd_soc_component *compone
 	rx_path_cfg0_reg = CDC_RX_RX0_RX_PATH_CFG0 +
 					(comp * CDC_RX_MACRO_RX_PATH_OFFSET);
 	if (SND_SOC_DAPM_EVENT_ON(event)) {
-		lpass_cdc_load_compander_coeff(component,
+		rx_macro_load_compander_coeff(component,
 				comp_coeff_lsb_reg, comp_coeff_msb_reg,
 				comp_coeff_table[rx_priv->hph_pwr_mode],
 				COMP_MAX_COEFF);
 
-		lpass_cdc_update_compander_setting(component,
+		rx_macro_update_compander_setting(component,
 					comp_ctl8_reg,
 					&comp_setting_table[mode]);
 
@@ -2884,7 +2887,7 @@ static int lpass_cdc_rx_macro_enable_interp_clk(struct snd_soc_component *compon
 			++rx_priv->pcm_select_users;
 		}
 #endif
-			lpass_cdc_notify_wcd_rx_clk(rx_dev, rx_priv->is_native_on);
+			rx_macro_notify_wcd_rx_clk(rx_dev, rx_priv->is_native_on);
 		}
 		rx_priv->main_clk_users[interp_idx]++;
 	}
@@ -4481,7 +4484,7 @@ static int lpass_cdc_rx_macro_core_vote(void *handle, bool enable)
 
 	if (enable) {
 		pm_runtime_get_sync(rx_priv->dev);
-		if (lpass_cdc_check_core_votes(rx_priv->dev))
+		if (rx_macro_check_core_votes(rx_priv->dev))
 			rc = 0;
 		else
 			rc = -ENOTSYNC;
@@ -4510,7 +4513,7 @@ static int rx_swrm_clock(void *handle, bool enable)
 	if (enable) {
 		pm_runtime_get_sync(rx_priv->dev);
 		if (rx_priv->swr_clk_users == 0) {
-			ret = msm_cdc_pinctrl_select_active_state(
+			ret = rx_macro_pinctrl_select_active_state(
 						rx_priv->rx_swr_gpio_p);
 			if (ret < 0) {
 				dev_err_ratelimited(rx_priv->dev,
@@ -4522,7 +4525,7 @@ static int rx_swrm_clock(void *handle, bool enable)
 			}
 			ret = lpass_cdc_rx_macro_mclk_enable(rx_priv, 1, true);
 			if (ret < 0) {
-				msm_cdc_pinctrl_select_sleep_state(
+				rx_macro_pinctrl_select_sleep_state(
 						rx_priv->rx_swr_gpio_p);
 				dev_err_ratelimited(rx_priv->dev,
 					"%s: rx request clock enable failed\n",
@@ -4561,7 +4564,7 @@ static int rx_swrm_clock(void *handle, bool enable)
 				CDC_RX_CLK_RST_CTRL_SWR_CONTROL,
 				0x01, 0x00);
 			lpass_cdc_rx_macro_mclk_enable(rx_priv, 0, true);
-			ret = msm_cdc_pinctrl_select_sleep_state(
+			ret = rx_macro_pinctrl_select_sleep_state(
 						rx_priv->rx_swr_gpio_p);
 			if (ret < 0) {
 				dev_err_ratelimited(rx_priv->dev,
@@ -4628,7 +4631,7 @@ static int lpass_cdc_rx_macro_init(struct snd_soc_component *component)
 	struct lpass_cdc_rx_macro_priv *rx_priv = NULL;
 	int i;
 
-	rx_dev = lpass_cdc_get_device_ptr(component->dev, RX_MACRO);
+	rx_dev = rx_macro_get_device_ptr(component->dev, RX_MACRO);
 	if (!rx_dev) {
 		dev_err(component->dev,
 			"%s: null device for macro!\n", __func__);
@@ -4841,7 +4844,7 @@ static int lpass_cdc_rx_macro_probe(struct platform_device *pdev)
 	u32 is_used_rx_swr_gpio = 1;
 	const char *is_used_rx_swr_gpio_dt = "qcom,is-used-swr-gpio";
 
-	if (!lpass_cdc_is_va_macro_registered(&pdev->dev)) {
+	if (!rx_macro_is_va_macro_registered(&pdev->dev)) {
 		dev_err(&pdev->dev,
 			"%s: va-macro not registered yet, defer\n", __func__);
 		return -EPROBE_DEFER;
@@ -4898,13 +4901,13 @@ static int lpass_cdc_rx_macro_probe(struct platform_device *pdev)
 			__func__);
 		return -EINVAL;
 	}
-	if (msm_cdc_pinctrl_get_state(rx_priv->rx_swr_gpio_p) < 0 &&
+	if (rx_macro_pinctrl_get_state(rx_priv->rx_swr_gpio_p) < 0 &&
 		is_used_rx_swr_gpio) {
 		dev_err(&pdev->dev, "%s: failed to get swr pin state\n",
 			__func__);
 		return -EPROBE_DEFER;
 	}
-	msm_cdc_pinctrl_set_wakeup_capable(
+	rx_macro_pinctrl_set_wakeup_capable(
 				rx_priv->rx_swr_gpio_p, false);
 
 	rx_io_base = devm_ioremap(&pdev->dev, rx_base_addr,
@@ -4979,7 +4982,7 @@ static int lpass_cdc_rx_macro_probe(struct platform_device *pdev)
 	mutex_init(&rx_priv->swr_clk_lock);
 	lpass_cdc_rx_macro_init_ops(&ops, rx_io_base);
 
-	ret = lpass_cdc_register_macro(&pdev->dev, RX_MACRO, &ops);
+	ret = rx_macro_register(&pdev->dev, RX_MACRO, &ops);
 	if (ret) {
 		dev_err(&pdev->dev,
 			"%s: register macro failed\n", __func__);
@@ -5021,7 +5024,7 @@ static int lpass_cdc_rx_macro_remove(struct platform_device *pdev)
 
 	pm_runtime_disable(&pdev->dev);
 	pm_runtime_set_suspended(&pdev->dev);
-	lpass_cdc_unregister_macro(&pdev->dev, RX_MACRO);
+	rx_macro_unregister(&pdev->dev, RX_MACRO);
 	mutex_destroy(&rx_priv->mclk_lock);
 	mutex_destroy(&rx_priv->swr_clk_lock);
 	kfree(rx_priv->swr_ctrl_data);
-- 
2.34.1

