From c14d2c05bfc56c04c0154bcc878a267936de4a4c Mon Sep 17 00:00:00 2001
From: AURA Conversion Engine <aura@example.invalid>
Date: Thu, 18 Jun 2026 03:19:45 +0530
Subject: [PATCH 05/10] ASoC: codecs: lpass-rx-macro: own MMIO regmap and
 callbacks

---
 asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c | 38 ++++++++++++++++++++--
 1 file changed, 35 insertions(+), 3 deletions(-)

diff --git a/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c b/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
index 90e2470..4b75f94 100644
--- a/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
+++ b/asoc/codecs/lpass-cdc/lpass-cdc-rx-macro.c
@@ -24,6 +24,32 @@ static inline int rx_macro_notify(void *handle, int event, void *data)
 	return 0;
 }
 
+static bool rx_macro_readable_register(struct device *dev, unsigned int reg)
+{
+	return reg <= CDC_RX_MACRO_MAX_OFFSET;
+}
+
+static bool rx_macro_writeable_register(struct device *dev, unsigned int reg)
+{
+	return reg <= CDC_RX_MACRO_MAX_OFFSET;
+}
+
+static bool rx_macro_volatile_register(struct device *dev, unsigned int reg)
+{
+	return false;
+}
+
+static const struct regmap_config rx_macro_regmap_config = {
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.max_register = CDC_RX_MACRO_MAX_OFFSET,
+	.readable_reg = rx_macro_readable_register,
+	.writeable_reg = rx_macro_writeable_register,
+	.volatile_reg = rx_macro_volatile_register,
+	.cache_type = REGCACHE_FLAT,
+};
+
 static inline int rx_macro_is_va_macro_registered(struct device *dev) { return 1; }
 static inline int rx_macro_register(...) { return 0; }
 static inline void rx_macro_unregister(...) { }
@@ -500,6 +526,7 @@ enum {
  */
 struct lpass_cdc_rx_macro_priv {
 	struct device *dev;
+	struct regmap *regmap;
 	int comp_enabled[CDC_RX_MACRO_COMP_MAX];
 	u8 is_pcm_enabled;
 	/* Main path clock users count */
@@ -1313,7 +1340,7 @@ static int lpass_cdc_rx_macro_mclk_enable(
 				struct lpass_cdc_rx_macro_priv *rx_priv,
 				bool mclk_enable, bool dapm)
 {
-	struct regmap *regmap = dev_get_regmap(rx_priv->dev->parent, NULL);
+	struct regmap *regmap = rx_priv->regmap;
 	int ret = 0;
 
 	if (regmap == NULL) {
@@ -2999,7 +3026,7 @@ static void lpass_cdc_rx_macro_restore_iir_coeff(struct lpass_cdc_rx_macro_priv
 				int band_idx)
 {
 	u16 reg_add = 0, coeff_idx = 0, idx = 0;
-	struct regmap *regmap = dev_get_regmap(rx_priv->dev->parent, NULL);
+	struct regmap *regmap = rx_priv->regmap;
 
 	if (regmap == NULL) {
 		dev_err_ratelimited(rx_priv->dev, "%s: regmap is NULL\n", __func__);
@@ -4498,7 +4525,7 @@ static int lpass_cdc_rx_macro_core_vote(void *handle, bool enable)
 static int rx_swrm_clock(void *handle, bool enable)
 {
 	struct lpass_cdc_rx_macro_priv *rx_priv = (struct lpass_cdc_rx_macro_priv *) handle;
-	struct regmap *regmap = dev_get_regmap(rx_priv->dev->parent, NULL);
+	struct regmap *regmap = rx_priv->regmap;
 	int ret = 0;
 
 	if (regmap == NULL) {
@@ -4917,6 +4944,11 @@ static int lpass_cdc_rx_macro_probe(struct platform_device *pdev)
 		return -ENOMEM;
 	}
 	rx_priv->rx_io_base = rx_io_base;
+	rx_priv->regmap = devm_regmap_init_mmio(&pdev->dev, rx_io_base, &rx_macro_regmap_config);
+	if (IS_ERR(rx_priv->regmap)) {
+		dev_err(&pdev->dev, "%s: regmap init failed\n", __func__);
+		return PTR_ERR(rx_priv->regmap);
+	}
 	muxsel_io = devm_ioremap(&pdev->dev, muxsel, 0x4);
 	if (!muxsel_io) {
 		dev_err(&pdev->dev, "%s: ioremap failed for muxsel\n",
-- 
