+		ret = clk_prepare_enable(va_priv->mclk);
+		if (ret)
+			return ret;
+		ret = va_clk_rsc_fs_gen_request(va_priv, true);
+		if (ret)
+			clk_disable_unprepare(va_priv->mclk);
+		return ret;
+	}
+
+	va_clk_rsc_fs_gen_request(va_priv, false);
+	clk_disable_unprepare(va_priv->mclk);
 	return 0;
 }

