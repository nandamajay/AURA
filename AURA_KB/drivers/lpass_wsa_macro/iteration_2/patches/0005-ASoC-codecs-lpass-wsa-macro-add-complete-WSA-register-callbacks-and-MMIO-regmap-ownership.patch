+
+static bool wsa_macro_writeable_register(struct device *dev, unsigned int reg)
+{
+	if (wsa_macro_readable_register(dev, reg))
+		return true;
+
+	return false;
+}
+
+static bool wsa_macro_volatile_register(struct device *dev, unsigned int reg)
+{
+	switch (reg) {
+	case CDC_WSA_CLK_RST_CTRL_FS_CNT_CONTROL:
+	case CDC_WSA_CLK_RST_CTRL_SWR_CONTROL:
+	case CDC_WSA_MACRO_SWR_STRING_LEN:
+	case CDC_WSA_MACRO_THERMAL_MAX_STATE:
+	case CDC_WSA_RX_INP_MUX_RX_INT0_CFG0:
+	case CDC_WSA_RX_INP_MUX_RX_INT0_CFG1:
+	case CDC_WSA_RX_INP_MUX_RX_INT1_CFG0:
+	case CDC_WSA_RX_INP_MUX_RX_INT1_CFG1:
+
+		return true;
+	default:
+		return false;
+	}
+}
+
+static const struct regmap_config wsa_macro_regmap_config = {
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.cache_type = REGCACHE_FLAT,
+	.readable_reg = wsa_macro_readable_register,
+	.writeable_reg = wsa_macro_writeable_register,
+	.volatile_reg = wsa_macro_volatile_register,
+};
+
+static struct regmap *wsa_macro_init_mmio_regmap(struct platform_device *pdev)
+{
+	void __iomem *base;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return ERR_CAST(base);
+
+	return devm_regmap_init_mmio(&pdev->dev, base, &wsa_macro_regmap_config);
+}
+
 static int wsa_macro_hw_params(struct snd_pcm_substream *substream,
 			       struct snd_pcm_hw_params *params,
 			       struct snd_soc_dai *dai);
