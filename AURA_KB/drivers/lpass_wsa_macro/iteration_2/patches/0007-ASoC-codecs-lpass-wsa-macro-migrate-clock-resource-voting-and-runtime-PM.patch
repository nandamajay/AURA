From 481891087208f4eecb68f21c5e68b4bb7a2b214b Mon Sep 17 00:00:00 2001
From: AURA Conversion Engine <aura@example.invalid>
Date: Wed, 17 Jun 2026 18:39:16 +0530
Subject: [PATCH 7/12] ASoC: codecs: lpass-wsa-macro: migrate clock resource
 voting and runtime PM

---
 asoc/codecs/lpass-cdc/lpass-cdc-wsa-macro.c | 37 +++++++++++++++++----
 1 file changed, 30 insertions(+), 7 deletions(-)

diff --git a/asoc/codecs/lpass-cdc/lpass-cdc-wsa-macro.c b/asoc/codecs/lpass-cdc/lpass-cdc-wsa-macro.c
index 82e2a62..44a4a80 100644
--- a/asoc/codecs/lpass-cdc/lpass-cdc-wsa-macro.c
+++ b/asoc/codecs/lpass-cdc/lpass-cdc-wsa-macro.c
@@ -8,6 +8,8 @@
 #include <linux/io.h>
 #include <linux/platform_device.h>
 #include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/of_clk.h>
 #include <linux/regmap.h>
 #include <linux/thermal.h>
 #include <linux/pm_runtime.h>
@@ -17,7 +19,6 @@
 #include <sound/tlv.h>
 #include "lpass-cdc-wsa-macro.h"
 #include "lpass-macro-common.h"
-#include "lpass-cdc-clk-rsc.h"
 
 #define AUTO_SUSPEND_DELAY  50 /* delay in msec */
 #define CDC_WSA_MACRO_MAX_OFFSET 0x1000
@@ -185,6 +186,28 @@ static struct interp_sample_rate int_mix_sample_rate_val[] = {
 
 #define CDC_WSA_MACRO_SWR_STRING_LEN 80
 
+
+static int wsa_macro_runtime_suspend(struct device *dev)
+{
+	struct regmap *regmap = dev_get_regmap(dev, NULL);
+
+	regcache_cache_only(regmap, true);
+	regcache_mark_dirty(regmap);
+	return 0;
+}
+
+static int wsa_macro_runtime_resume(struct device *dev)
+{
+	struct regmap *regmap = dev_get_regmap(dev, NULL);
+
+	regcache_cache_only(regmap, false);
+	return regcache_sync(regmap);
+}
+
+static const struct dev_pm_ops wsa_macro_pm_ops = {
+	RUNTIME_PM_OPS(wsa_macro_runtime_suspend, wsa_macro_runtime_resume, NULL)
+};
+
 static int wsa_macro_core_vote(void *handle, bool enable);
 
 static bool wsa_macro_readable_register(struct device *dev, unsigned int reg)
@@ -1247,7 +1270,7 @@ static int wsa_macro_mclk_enable(
 	mutex_lock(&wsa_priv->mclk_lock);
 	if (mclk_enable) {
 		if (wsa_priv->wsa_mclk_users == 0) {
-			ret = lpass_cdc_clk_rsc_request_clock(wsa_priv->dev,
+			ret = wsa_macro_request_clock(wsa_priv->dev,
 							wsa_priv->default_clk_id,
 							wsa_priv->default_clk_id,
 							true);
@@ -1257,7 +1280,7 @@ static int wsa_macro_mclk_enable(
 					__func__);
 				goto exit;
 			}
-			lpass_cdc_clk_rsc_fs_gen_request(wsa_priv->dev,
+			wsa_macro_fsgen_request(wsa_priv->dev,
 						  true);
 			regcache_mark_dirty(regmap);
 			regcache_sync_region(regmap,
@@ -1296,10 +1319,10 @@ static int wsa_macro_mclk_enable(
 			regmap_update_bits(regmap,
 				CDC_WSA_CLK_RST_CTRL_MCLK_CONTROL,
 				0x01, 0x00);
-			lpass_cdc_clk_rsc_fs_gen_request(wsa_priv->dev,
+			wsa_macro_fsgen_request(wsa_priv->dev,
 						  false);
 
-			lpass_cdc_clk_rsc_request_clock(wsa_priv->dev,
+			wsa_macro_request_clock(wsa_priv->dev,
 						  wsa_priv->default_clk_id,
 						  wsa_priv->default_clk_id,
 						  false);
@@ -1385,8 +1408,8 @@ static int wsa_macro_event_handler(struct snd_soc_component *component,
 				SDW_SLAVE_ATTACHED, NULL);
 		break;
 	case LPASS_CDC_MACRO_EVT_CLK_RESET:
-		lpass_cdc_rsc_clk_reset(wsa_dev, WSA_CORE_CLK);
-		lpass_cdc_rsc_clk_reset(wsa_dev, WSA_TX_CORE_CLK);
+		wsa_macro_clk_reset(wsa_dev, WSA_CORE_CLK);
+		wsa_macro_clk_reset(wsa_dev, WSA_TX_CORE_CLK);
 		break;
 	}
 	return 0;
-- 
