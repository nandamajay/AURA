From 39e47ce4b8c23ff3a190ca86b85e7b0bdfb8d1d9 Mon Sep 17 00:00:00 2001
From: AURA Conversion Engine <aura@example.invalid>
Date: Wed, 17 Jun 2026 18:39:16 +0530
Subject: [PATCH 9/12] ASoC: codecs: lpass-wsa-macro: resolve vdd-micb supply
 with optional regulator handling

---
 asoc/codecs/lpass-cdc/lpass-cdc-wsa-macro.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/asoc/codecs/lpass-cdc/lpass-cdc-wsa-macro.c b/asoc/codecs/lpass-cdc/lpass-cdc-wsa-macro.c
index 6872b8f..640b90a 100644
--- a/asoc/codecs/lpass-cdc/lpass-cdc-wsa-macro.c
+++ b/asoc/codecs/lpass-cdc/lpass-cdc-wsa-macro.c
@@ -7,6 +7,7 @@
 #include <linux/init.h>
 #include <linux/io.h>
 #include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
 #include <linux/clk.h>
 #include <linux/clk-provider.h>
 #include <linux/of_clk.h>
@@ -208,6 +209,23 @@ static const struct dev_pm_ops wsa_macro_pm_ops = {
 	RUNTIME_PM_OPS(wsa_macro_runtime_suspend, wsa_macro_runtime_resume, NULL)
 };
 
+
+static int wsa_macro_get_vdd_micb(struct device *dev)
+{
+	struct regulator *vdd_micb;
+	int ret;
+
+	vdd_micb = devm_regulator_get_optional(dev, "vdd-micb");
+	if (IS_ERR(vdd_micb))
+		return PTR_ERR(vdd_micb) == -ENODEV ? 0 : PTR_ERR(vdd_micb);
+
+	ret = regulator_enable(vdd_micb);
+	if (ret)
+		return ret;
+
+	return devm_add_action_or_reset(dev, (void(*)(void *))regulator_disable, vdd_micb);
+}
+
 static int wsa_macro_core_vote(void *handle, bool enable);
 
 
