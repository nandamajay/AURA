From 64d7500b245bd55dda6ec39278670f7de8c57347 Mon Sep 17 00:00:00 2001
From: AURA Bot <aura@example.com>
Date: Sat, 20 Jun 2026 01:47:47 +0530
Subject: [PATCH 4/5] RFC: ASoC: codecs: add WCD9378 Kconfig/Makefile fragments

---
 sound/soc/codecs/Kconfig.fragment  | 20 ++++++++++++++++++++
 sound/soc/codecs/Makefile.fragment | 10 ++++++++++
 2 files changed, 30 insertions(+)
 create mode 100644 sound/soc/codecs/Kconfig.fragment
 create mode 100644 sound/soc/codecs/Makefile.fragment

diff --git a/sound/soc/codecs/Kconfig.fragment b/sound/soc/codecs/Kconfig.fragment
new file mode 100644
index 0000000..aaf462d
--- /dev/null
+++ b/sound/soc/codecs/Kconfig.fragment
@@ -0,0 +1,20 @@
+# RFC static prototype fragment for WCD9378 codec enablement
+
+config SND_SOC_WCD9378
+	depends on SND_SOC_WCD9378_SDW
+	tristate
+	depends on SOUNDWIRE || !SOUNDWIRE
+	select SND_SOC_WCD_CLASSH
+	select SND_SOC_WCD_COMMON
+
+config SND_SOC_WCD9378_SDW
+	tristate "WCD9378 Codec - SDW (RFC static prototype)"
+	select SND_SOC_WCD9378
+	select SND_SOC_WCD_MBHC
+	select REGMAP_IRQ
+	depends on SOUNDWIRE
+	select REGMAP_SOUNDWIRE
+	help
+	  RFC static prototype for Qualcomm WCD9378 codec and SoundWire slave
+	  split driver layout. This fragment is compile-oriented and does not
+	  assert runtime validation.
diff --git a/sound/soc/codecs/Makefile.fragment b/sound/soc/codecs/Makefile.fragment
new file mode 100644
index 0000000..a6ab343
--- /dev/null
+++ b/sound/soc/codecs/Makefile.fragment
@@ -0,0 +1,10 @@
+# RFC static prototype fragment for WCD9378 codec object wiring
+
+snd-soc-wcd9378-y := wcd9378.o
+snd-soc-wcd9378-sdw-y := wcd9378-sdw.o
+
+obj-$(CONFIG_SND_SOC_WCD9378)	+= snd-soc-wcd9378.o
+ifdef CONFIG_SND_SOC_WCD9378_SDW
+# Keep SDW aggregate side built with codec when SDW support is enabled.
+obj-$(CONFIG_SND_SOC_WCD9378) += snd-soc-wcd9378-sdw.o
+endif
-- 
