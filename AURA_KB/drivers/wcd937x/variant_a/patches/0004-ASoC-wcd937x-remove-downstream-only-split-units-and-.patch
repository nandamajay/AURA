-		return -EINVAL;
-	}
-
-	wcd937x = snd_soc_component_get_drvdata(component);
-	if (!wcd937x) {
-		pr_err("%s: wcd937x is NULL\n", __func__);
-		return -EINVAL;
-	}
-
-	wcd937x_mbhc = wcd937x->mbhc;
-	if (!wcd937x_mbhc) {
-		dev_err(component->dev, "%s: mbhc not initialized!\n",
