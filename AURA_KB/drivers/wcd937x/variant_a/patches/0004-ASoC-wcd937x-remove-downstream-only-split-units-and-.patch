From d7557d4ebf1ade2e74253e6e247fb5a1dc37fc86 Mon Sep 17 00:00:00 2001
From: AURA Conversion <aura@example.invalid>
Date: Fri, 19 Jun 2026 19:45:29 +0530
Subject: [PATCH 4/4] ASoC: wcd937x: remove downstream-only split units and
 stale vendor build paths

---
 Kbuild              |    6 +-
 internal.h          |  180 -------
 wcd937x-mbhc.c      | 1159 -------------------------------------------
 wcd937x-mbhc.h      |   67 ---
 wcd937x-registers.h |  438 ----------------
 wcd937x-regmap.c    |  465 -----------------
 wcd937x-tables.c    |  422 ----------------
 7 files changed, 3 insertions(+), 2734 deletions(-)
 delete mode 100644 internal.h
 delete mode 100644 wcd937x-mbhc.c
 delete mode 100644 wcd937x-mbhc.h
 delete mode 100644 wcd937x-registers.h
 delete mode 100644 wcd937x-regmap.c
 delete mode 100644 wcd937x-tables.c

diff --git a/Kbuild b/Kbuild
index e317513..c53bd92 100644
--- a/Kbuild
+++ b/Kbuild
@@ -84,8 +84,8 @@ ifdef CONFIG_SND_SOC_WCD937X
 	WCD937X_OBJS += wcd937x-mbhc.o
 endif
 
-ifdef CONFIG_SND_SOC_WCD937X_SLAVE
-	WCD937X_SLAVE_OBJS += wcd937x_slave.o
+ifdef CONFIG_SND_SOC_WCD937X_SDW
+	WCD937X_SLAVE_OBJS += wcd937x-sdw.o
 endif
 
 LINUX_INC +=	-Iinclude/linux
@@ -126,7 +126,7 @@ endif
 obj-$(CONFIG_SND_SOC_WCD937X) += wcd937x_dlkm.o
 wcd937x_dlkm-y := $(WCD937X_OBJS)
 
-obj-$(CONFIG_SND_SOC_WCD937X_SLAVE) += wcd937x_slave_dlkm.o
+obj-$(CONFIG_SND_SOC_WCD937X_SDW) += wcd937x_slave_dlkm.o
 wcd937x_slave_dlkm-y := $(WCD937X_SLAVE_OBJS)
 
 # inject some build related information
