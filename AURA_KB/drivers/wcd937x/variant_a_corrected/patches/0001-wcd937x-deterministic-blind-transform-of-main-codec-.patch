Subject: [PATCH 1/3] wcd937x: deterministic blind transform of main codec file

---
 wcd937x.c | 81 ++++++++++++++++++++++---------------------------------
 1 file changed, 32 insertions(+), 49 deletions(-)

diff --git a/wcd937x.c b/wcd937x.c
index 8dceb98..cb4c91a 100644
--- a/wcd937x.c
+++ b/wcd937x.c
@@ -15,19 +15,19 @@
 #include <linux/pm_runtime.h>
