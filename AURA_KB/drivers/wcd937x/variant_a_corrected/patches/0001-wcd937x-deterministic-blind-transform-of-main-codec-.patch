 	wcd937x->dev = dev;
 	wcd937x->dev->platform_data = pdata;
 	wcd937x->rst_np = pdata->rst_np;
-	ret = msm_cdc_init_supplies(dev, &wcd937x->supplies,
+	ret = wcd937x_fc_init_supplies(dev, &wcd937x->supplies,
 				    pdata->regulator, pdata->num_supplies);
