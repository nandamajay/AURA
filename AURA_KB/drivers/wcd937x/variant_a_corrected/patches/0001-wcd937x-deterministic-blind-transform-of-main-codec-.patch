+	pdata->rx_slave = of_parse_phandle(dev->of_node, "qcom,rx-device", 0);
+	pdata->tx_slave = of_parse_phandle(dev->of_node, "qcom,tx-device", 0);
 	wcd937x_dt_parse_micbias_info(dev, &pdata->micbias);
 
 	return pdata;
