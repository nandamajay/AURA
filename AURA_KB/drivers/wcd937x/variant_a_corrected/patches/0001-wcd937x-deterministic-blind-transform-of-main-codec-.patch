+	{ .compatible = "qcom,wcd9370-codec", .data = "wcd9370" },
+	{ .compatible = "qcom,wcd9375-codec", .data = "wcd9375" },
 	{}
 };
 
@@ -3644,7 +3634,7 @@ static int wcd937x_add_slave_components(struct device *dev,
 
 	np = dev->of_node;
 
