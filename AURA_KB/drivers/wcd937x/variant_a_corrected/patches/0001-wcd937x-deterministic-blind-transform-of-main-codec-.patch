+		ret = wcd937x_fc_disable_ondemand_supply(wcd937x->dev,
 						wcd937x->supplies,
 						pdata->regulator,
 						pdata->num_supplies,
@@ -3239,11 +3228,11 @@ static int wcd937x_reset(struct device *dev)
 		return -EINVAL;
 	}
 
