+	rx_node = of_parse_phandle(np, "qcom,rx-device", 0);
 	if (!rx_node) {
 		dev_err(dev, "%s: Rx-slave node not defined\n", __func__);
 		return -ENODEV;
@@ -3655,7 +3645,7 @@ static int wcd937x_add_slave_components(struct device *dev,
 			wcd937x_compare_of,
 			rx_node);
 
-	tx_node = of_parse_phandle(np, "qcom,tx-slave", 0);
+	tx_node = of_parse_phandle(np, "qcom,tx-device", 0);
 	if (!tx_node) {
