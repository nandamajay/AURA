-
-	wsa883x = pde_data(file_inode(filep));
-	if (!wsa883x)
-		return -EINVAL;
-
-	ret = regdump_read(wsa883x->regmap, WSA883X_BASE, WSA883X_MAX_REGISTER, buf, size, ppos);
-	return ret;
-}
-static const struct proc_ops wsa883x_proc_ops = {
-	.proc_read = wsa883x_proc_read,
-};
 
