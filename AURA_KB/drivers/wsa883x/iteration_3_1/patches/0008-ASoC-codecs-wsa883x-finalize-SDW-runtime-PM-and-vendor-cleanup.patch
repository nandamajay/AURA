+
+static int wsa883x_runtime_suspend(struct device *dev)
+{
+	struct regmap *regmap = dev_get_regmap(dev, NULL);
+	struct wsa883x_priv *wsa883x = dev_get_drvdata(dev);
+
+	wsa883x_gpio_ctrl(wsa883x, false);
+	regcache_cache_only(regmap, true);
+	regcache_mark_dirty(regmap);
+	return 0;
+}
+
+static int wsa883x_runtime_resume(struct device *dev)
+{
+	struct sdw_slave *slave = dev_to_sdw_dev(dev);
+	struct regmap *regmap = dev_get_regmap(dev, NULL);
+	struct wsa883x_priv *wsa883x = dev_get_drvdata(dev);
+	unsigned long time;
+
+	wsa883x_gpio_ctrl(wsa883x, true);
+	time = wait_for_completion_timeout(&slave->initialization_complete,
+					   msecs_to_jiffies(500));
+	if (!time)
+		return -ETIMEDOUT;
+
+	regcache_cache_only(regmap, false);
+	return regcache_sync(regmap);
+}
+
 static const struct dev_pm_ops wsa883x_sdw_pm_ops = {
-	.suspend_late = wsa883x_sdw_suspend,
-	.resume_early = wsa883x_sdw_resume,
+	RUNTIME_PM_OPS(wsa883x_runtime_suspend, wsa883x_runtime_resume, NULL)
 };
 
