-		usleep_range(500, 510);
-
-		wsa883x_sdw_up(wsa883x);
-		/* Add delay to allow enumerate */
-		usleep_range(20000, 20010);
-		wsa883x_sdw_reset(wsa883x);
-		break;
-
-	case BOLERO_SLV_EVT_PA_ON_POST_FSCLK:
