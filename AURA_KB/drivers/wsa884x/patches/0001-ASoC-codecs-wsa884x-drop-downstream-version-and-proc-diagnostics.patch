From: AURA Conversion Engine <aura@example.invalid>
Date: Wed, 17 Jun 2026 17:55:07 +0530
Subject: [PATCH 1/10] ASoC: codecs: wsa884x: drop downstream version and proc
 diagnostics

---
 asoc/codecs/wsa884x/wsa884x.c | 15 ++-------------
 1 file changed, 2 insertions(+), 13 deletions(-)

diff --git a/asoc/codecs/wsa884x/wsa884x.c b/asoc/codecs/wsa884x/wsa884x.c
index 1634e09..abc2f44 100644
--- a/asoc/codecs/wsa884x/wsa884x.c
+++ b/asoc/codecs/wsa884x/wsa884x.c
@@ -4,7 +4,6 @@
  * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  */
 
-#include <linux/version.h>
 #include <linux/module.h>
 #include <linux/init.h>
 #include <linux/slab.h>
@@ -33,8 +32,6 @@
 #include "wsa884x.h"
 #include "internal.h"
 #include "asoc/bolero-slave-internal.h"
-#include <linux/qti-regmap-debugfs.h>
-#include <linux/proc_fs.h>
 
 #define REGDUMP_PRINT_LEN 8
 
@@ -1732,11 +1729,7 @@ static int wsa884x_codec_probe(struct snd_soc_component *component)
 	struct swr_device *dev;
 	int variant = 0, version = 0;
 	struct snd_soc_dapm_context *dapm =
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
-			snd_soc_component_to_dapm(component);
-#else
-			snd_soc_component_get_dapm(component);
-#endif
+snd_soc_component_to_dapm(component);
 
 	if (!wsa884x)
 		return -EINVAL;
@@ -2580,11 +2573,7 @@ static int wsa884x_swr_suspend(struct device *dev)
 	dev_dbg(dev, "%s: system suspend\n", __func__);
 	if (wsa884x->dapm_bias_off ||
 		(wsa884x->component &&
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
-		(snd_soc_dapm_get_bias_level(snd_soc_component_to_dapm(wsa884x->component)) ==
-#else
-		(snd_soc_component_get_bias_level(wsa884x->component) ==
-#endif
+(snd_soc_dapm_get_bias_level(snd_soc_component_to_dapm(wsa884x->component)) ==
 		 SND_SOC_BIAS_OFF))) {
 		msm_cdc_set_supplies_lpm_mode(dev, wsa884x->supplies,
 					wsa884x->regulator,
