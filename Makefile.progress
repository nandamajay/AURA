	@python3 scripts/progress/start_phase.py phase_2
	@python3 scripts/progress/generate_dashboard.py

progress-phase2-complete: ## Mark Phase 2 as completed
	@python3 scripts/progress/complete_phase.py phase_2
	@python3 scripts/progress/generate_dashboard.py

progress-phase3-start: ## Mark Phase 3 as started
	@python3 scripts/progress/start_phase.py phase_3
	@python3 scripts/progress/generate_dashboard.py

progress-phase3-complete: ## Mark Phase 3 as completed
	@python3 scripts/progress/complete_phase.py phase_3
	@python3 scripts/progress/generate_dashboard.py

progress-phase4-start: ## Mark Phase 4 as started
	@python3 scripts/progress/start_phase.py phase_4
	@python3 scripts/progress/generate_dashboard.py

progress-phase4-complete: ## Mark Phase 4 as completed
	@python3 scripts/progress/complete_phase.py phase_4
	@python3 scripts/progress/generate_dashboard.py

progress-phase5-start: ## Mark Phase 5 as started
	@python3 scripts/progress/start_phase.py phase_5
	@python3 scripts/progress/generate_dashboard.py

progress-phase5-complete: ## Mark Phase 5 as completed
