.PHONY: progress-phase0-start progress-phase0-complete \
        progress-phase1-start progress-phase1-complete \
        progress-phase2-start progress-phase2-complete \
        progress-phase3-start progress-phase3-complete \
        progress-phase4-start progress-phase4-complete \
        progress-phase5-start progress-phase5-complete \
        progress-phase6-start progress-phase6-complete
