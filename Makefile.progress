	@python3 scripts/progress/start_phase.py phase_1
	@python3 scripts/progress/generate_dashboard.py

progress-phase1-complete: ## Mark Phase 1 as completed
	@python3 scripts/progress/complete_phase.py phase_1
	@python3 scripts/progress/generate_dashboard.py

