{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURA Core Task Contract v1",
  "description": "Task object passed through orchestrator and worker dispatch.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "integer"
    },
    "module": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "round_num": {
      "type": [
        "integer",
        "null"
      ]
    },
    "agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "created_ts": {
      "type": [
        "number",
        "null"
      ]
    },
    "updated_ts": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "module",
    "status"
  ]
}
