{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURA Governance Verdict Contract v1",
  "description": "Approval/gate verdict emitted for patch and production decisions.",
  "type": "object",
  "properties": {
    "approval_gate_passed": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "WARN",
        "FAIL_CLOSED",
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "NONE"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decided_by": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "approval_gate_passed"
  ]
}
