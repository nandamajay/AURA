{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURA LLM Request Contract v1",
  "description": "Optional LLM/provider request-response envelope for AURA agents.",
  "type": "object",
  "properties": {
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ]
      }
    },
    "temperature": {
      "type": [
        "number",
        "null"
      ]
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "response": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "usage": {
          "type": "object"
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "required": [
    "messages"
  ]
}
