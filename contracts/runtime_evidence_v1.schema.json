{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURA Runtime Evidence Contract v1",
  "description": "Runtime/audit evidence artifact envelope.",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "artifact_id",
    "source",
    "timestamp",
    "kind",
    "payload"
  ]
}
