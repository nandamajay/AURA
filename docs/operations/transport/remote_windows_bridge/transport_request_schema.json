{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remote Transport Request Block",
  "type": "object",
  "required": [
    "protocol_version",
    "request_id",
    "approved_commands",
    "timeout_seconds",
    "transport",
    "execution_mode",
    "request_timestamp",
    "request_integrity_sha256"
  ],
  "properties": {
    "protocol_version": {"type": "string"},
    "request_id": {"type": "string", "minLength": 1},
    "approved_commands": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "transport": {"type": "string", "minLength": 1},
    "execution_mode": {"type": "string", "minLength": 1},
    "request_timestamp": {"type": "string", "minLength": 1},
    "request_integrity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
