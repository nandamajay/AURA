{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AURA Distributed Runtime Protocol",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"}
  ],
  "$defs": {
    "verdict_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "APPROVED",
          "EXECUTING",
          "COMPLETED",
          "PARTIAL",
          "TIMEOUT",
          "INVALID",
          "REJECTED",
          "UNKNOWN"
        ]
      }
    },
    "timestamps": {
      "type": "object",
      "required": ["received_at", "started_at", "finished_at"],
      "properties": {
        "received_at": {"type": "string"},
        "started_at": {"type": "string"},
        "finished_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "protocol_version",
        "request_id",
        "request_sequence",
        "approved_commands",
        "timeout_seconds",
        "transport",
        "execution_mode",
        "request_timestamp",
        "request_integrity_sha256",
        "transport_metadata",
        "governance_verdict_chain"
      ],
      "properties": {
        "protocol_version": {"type": "string"},
        "request_id": {"type": "string", "minLength": 1},
        "request_sequence": {"type": "integer", "minimum": 1},
        "approved_commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "transport": {"type": "string", "minLength": 1},
        "execution_mode": {"type": "string", "minLength": 1},
        "request_timestamp": {"type": "string", "minLength": 1},
        "request_integrity_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transport_metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "governance_verdict_chain": {"$ref": "#/$defs/verdict_chain"}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "protocol_version",
        "request_id",
        "request_sequence",
        "approved_commands",
        "timeout_seconds",
        "transport",
        "execution_mode",
        "timestamps",
        "execution_status",
        "raw_output",
        "stderr",
        "request_integrity_sha256",
        "response_integrity_sha256",
        "transport_metadata",
        "executor_identity",
        "executor_heartbeat",
        "governance_verdict_chain"
      ],
      "properties": {
        "protocol_version": {"type": "string"},
        "request_id": {"type": "string", "minLength": 1},
        "request_sequence": {"type": "integer", "minimum": 1},
        "approved_commands": {
          "type": "array",
          "items": {"type": "string"}
        },
        "timeout_seconds": {"type": "integer", "minimum": 0},
        "transport": {"type": "string"},
        "execution_mode": {"type": "string"},
        "timestamps": {"$ref": "#/$defs/timestamps"},
        "execution_status": {
          "type": "string",
          "enum": [
            "executed",
            "timeout",
            "partial_response",
            "transport_disconnected",
            "invalid",
            "failed",
            "rejected_malformed_request"
          ]
        },
        "raw_output": {"type": "string"},
        "stderr": {"type": "string"},
        "command_results": {
          "type": "array"
        },
        "request_integrity_sha256": {
          "type": "string"
        },
        "response_integrity_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transport_metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "executor_identity": {
          "type": "object",
          "additionalProperties": true
        },
        "executor_heartbeat": {
          "type": "object",
          "required": ["heartbeat_counter", "heartbeat_timestamp", "connection_state"],
          "properties": {
            "heartbeat_counter": {"type": "integer", "minimum": 0},
            "heartbeat_timestamp": {"type": "string"},
            "connection_state": {"type": "string"}
          },
          "additionalProperties": true
        },
        "governance_verdict_chain": {"$ref": "#/$defs/verdict_chain"}
      },
      "additionalProperties": false
    }
  }
}
